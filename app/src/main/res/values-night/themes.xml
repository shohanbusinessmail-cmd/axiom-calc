<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base (dark) window theme. See values/themes.xml for the rationale, and for
      why windowLightNavigationBar and the enforce*Contrast attributes live in
      values-night-v27 and values-night-v29 rather than here.
    -->
    <style name="Base.Theme.AxiomCalc" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">#FFE7ECF3</item>
        <item name="android:textColorSecondary">#FF9AA6B6</item>
    </style>

    <style name="Theme.AxiomCalc" parent="Base.Theme.AxiomCalc" />
</resources>
