<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and above (dataExtractionRules).
  Cloud backup and device-to-device transfer both include the local database,
  the preference store and the DataStore file. Nothing is sent to any Axiom
  Calc server because no such server exists.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
