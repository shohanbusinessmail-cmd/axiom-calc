<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
   Axiom Calc : application manifest
  ============================================================================
   PRIVACY AND OFFLINE CONTRACT (enforced here, audited in
   SECURITY_AND_PRIVACY.md):

   1. android.permission.INTERNET is ABSENT from this manifest and from the
      merged manifest that ships, so the process cannot open a network socket
      at all. That is a hard, operating system enforced guarantee that the app
      is offline only. CI fails the build if it ever appears.
   2. This manifest declares no permission of its own, but a dependency merge
      is not the same as a clean manifest: androidx.work contributes WAKE_LOCK,
      ACCESS_NETWORK_STATE, RECEIVE_BOOT_COMPLETED and FOREGROUND_SERVICE to
      the shipped APK. This app needs none of them. The only work it schedules
      is a best effort daily retention cleanup whose sole constraint is
      "battery not low": no network is consulted, no foreground service is
      started, no wake lock is held, and a cleanup missed across a reboot is
      caught by the read time and startup retention paths instead. All four are
      removed below with tools:node="remove", and the merged manifest audit in
      .github/workflows/android.yml fails if any of them reappears.
   3. Exactly one permission survives the merge:
      ${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION. It is not
      requested from the system and grants no capability. androidx.core
      DEFINES it on this app with protectionLevel="signature" and then asks for
      it, so that a receiver registered with RECEIVER_NOT_EXPORTED can only be
      signalled by this same application. It gives no access to the network, to
      storage, to hardware or to any other app's data. It is kept because
      WorkManager registers its force stop receiver through
      ContextCompat.registerReceiver, which relies on it; removing it would
      risk breaking WorkManager on API 24 to 32 devices that this project has
      no way to test. The trade off is recorded in SECURITY_AND_PRIVACY.md.
   4. Haptic key feedback uses Compose LocalHapticFeedback, which maps to
      View.performHapticFeedback and requires no VIBRATE permission.
   5. No analytics, advertising, crash reporting, remote configuration or
      licensing SDK is a dependency. CI asserts this against the release
      runtime classpath, not just against this file.
   6. The single queries element below exists only so the About screen can
      resolve a locally installed mail application for the owner contact
      action. A package visibility query is not a permission and grants no
      access to any data.
  ============================================================================
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Removed from the merged manifest. See contract item 2 above: androidx.work
      declares these, this app's single best-effort retention worker needs none
      of them, and ACCESS_NETWORK_STATE in particular has no place in an app
      that must never touch a network.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:name=".AxiomCalcApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.AxiomCalc"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.AxiomCalc">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          WorkManager is initialised on demand by AxiomCalcApplication, which
          implements Configuration.Provider. The default androidx.startup
          initialiser is removed so that no background component runs before
          the user retention preference has been read.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
