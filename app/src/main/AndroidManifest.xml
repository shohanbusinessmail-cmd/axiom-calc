<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
   Axiom Calc : application manifest
  ============================================================================
   PRIVACY AND OFFLINE CONTRACT (enforced here, audited in
   SECURITY_AND_PRIVACY.md):

   1. No uses-permission element of any kind is declared.
      android.permission.INTERNET is intentionally ABSENT, so the process
      cannot open a network socket at all. This is a hard, operating system
      enforced guarantee that the app is offline only.
   2. Haptic key feedback uses Compose LocalHapticFeedback, which maps to
      View.performHapticFeedback and requires no VIBRATE permission.
   3. No analytics, advertising, crash reporting, remote configuration or
      licensing SDK is a dependency, therefore no provider, service or
      receiver belonging to such an SDK appears in the merged manifest.
   4. The single queries element below exists only so the About screen can
      resolve a locally installed mail application for the owner contact
      action. A package visibility query is not a permission and grants no
      access to any data.
  ============================================================================
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:name=".app.AxiomCalcApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.AxiomCalc"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.AxiomCalc">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          WorkManager is initialised on demand by AxiomCalcApplication, which
          implements Configuration.Provider. The default androidx.startup
          initialiser is removed so that no background component runs before
          the user retention preference has been read.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
